{
  "name": "streampad",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm --filter @streampad/web build",
    "dev": "pnpm --filter @streampad/web dev",
    "spike:T1": "tsx spikes/t01-launch.ts",
    "spike:T2": "tsx spikes/t02-fee-sharing.ts",
    "spike:T4": "tsx spikes/t04-split.ts",
    "spike:T5": "tsx spikes/t05-cost.ts",
    "spike:T7": "tsx spikes/t07-recovery.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@pump-fun/pump-sdk": "^4.3.1",
    "@pump-fun/pump-swap-sdk": "^2.2.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "bn.js": "^5.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bigint-buffer",
      "bufferutil",
      "esbuild",
      "utf-8-validate"
    ]
  }
}
